# Copiez ce fichier en .env et remplissez les valeurs
DISCORD_TOKEN=votre_token_ici
# Optionnel : ID du serveur pour tester les slash commands instantanément
GUILD_ID=

# Calendrier des courses — annonces automatiques
RACES_CHANNEL_ID=
RACES_CATEGORY_ID=1399427481945247817
RACES_SITE_URL=https://paramourduspin.fun

# Auth bot ↔ site (même valeur dans les deux .env)
BOT_API_SECRET=

# Rôle staff pour les commandes /pregrid (et gestion-credits)
RACES_STAFF_ROLE_ID=1424791316881211412

# Anthropic — génération des laïus pré-grille
ANTHROPIC_API_KEY=
