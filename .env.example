# Copiez ce fichier en .env et remplissez les valeurs
DISCORD_TOKEN=votre_token_ici
# Optionnel : ID du serveur pour tester les slash commands instantanément
GUILD_ID=

# Calendrier des courses — annonces automatiques
RACES_CHANNEL_ID=
RACES_CATEGORY_ID=1399427481945247817
RACES_SITE_URL=https://paramourduspin.fun
# Salon où sont présentés les nouveaux tournois (avec leur affiche) — salon
# "communication" du serveur
TOURNOIS_ANNONCE_CHANNEL_ID=1505318885673664594

# Auth bot ↔ site (même valeur dans les deux .env)
BOT_API_SECRET=

# Rôle staff pour les commandes /pregrid (et gestion-credits)
RACES_STAFF_ROLE_ID=1424791316881211412
# Rôle pingé lors des annonces de course, de manche et de nouveau tournoi
RACES_NOTIFY_ROLE_ID=1505321380420255784

# Anthropic — génération des laïus pré-grille
ANTHROPIC_API_KEY=

# LMU sync — salon « maj LMU » (annonces d'horaires d'endurance)
# Valeur par défaut = ID du salon PADS, modifier uniquement si différent
LMU_CHANNEL_ID=1571872951349813398

# Onboarding PADS — envoi des inscriptions au site (POST /api/members/onboarding)
# URL par défaut = prod ; à surcharger pour un site de test
ONBOARDING_API_URL=https://paramourduspin.fun/api/members/onboarding
# Même valeur que ONBOARDING_API_KEY dans le .env du site
ONBOARDING_API_KEY=
# Salon staff des retours d'onboarding (si non défini via /onboarding setup)
ONBOARDING_STAFF_LOG_CHANNEL_ID=1573330447310786660
